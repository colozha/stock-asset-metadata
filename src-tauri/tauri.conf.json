{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stock Asset Metadata",
  "version": "0.1.1",
  "identifier": "com.stockassetmetadata.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Stock Asset Metadata", "width": 1440, "height": 900, "minWidth": 1024, "minHeight": 700 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": { "active": true, "targets": ["rpm"], "category": "GraphicsAndDesign", "icon": ["icons/icon.png"] }
}
