  "components": [
    {
      "name": "Primary save button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The coral save action, including the actual hover, focus, and disabled states.",
      "html": "<button class=\"ds-primary\" type=\"button\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 3h13l3 3v15H4V3ZM8 3v6h8V3M8 21v-8h8v8\"/></svg><span>Simpan metadata</span></button> <button class=\"ds-primary\" type=\"button\" disabled>Simpan metadata</button>",
      "css": ".ds-primary{box-sizing:border-box;font-family:system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:37px;padding:9px 14px;border:1px solid #b55b5e;border-radius:1px;background:var(--coral,#d06d6d);color:#271d25;font-size:12px;font-weight:650;white-space:nowrap;cursor:pointer;transition:background-color .14s ease,border-color .14s ease}.ds-primary:active:enabled{background:#d6e2eb}.ds-primary:hover:enabled{background:#bb565b;color:#fff;border-color:#aa494e}.ds-primary:focus-visible{outline:2px solid var(--purple,#7b68a4);outline-offset:2px}.ds-primary:disabled{opacity:1;cursor:default;background:#e5bcbc;color:#6e444b;border-color:#d6aaaa}.ds-icon{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:square;stroke-linejoin:miter;flex-shrink:0}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Secondary toolbar button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Cool compact import and editing actions with quiet pointer feedback.",
      "html": "<button class=\"ds-secondary\" type=\"button\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>Tambah file</button>",
      "css": ".ds-secondary{box-sizing:border-box;font-family:system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:34px;padding:7px 12px;border:1px solid var(--border,#a7bacb);border-radius:1px;background:var(--panel,#f7fafb);color:var(--text,#2f3f54);font-size:13px;cursor:pointer;transition:background-color .14s ease,border-color .14s ease}.ds-secondary:hover:enabled{background:#e1eaf0;border-color:#768ea7}.ds-secondary:active:enabled{background:#d6e2eb}.ds-secondary:focus-visible{outline:2px solid var(--purple,#7b68a4);outline-offset:2px}.ds-secondary:disabled{opacity:.5;cursor:default}.ds-icon{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:square;stroke-linejoin:miter;flex-shrink:0}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
      "name": "Metadata text field",
      "kind": "input",
      "refersTo": "field",
      "description": "Explicit metadata label, character count, and a white editing surface.",
      "html": "<div class=\"ds-field\"><div class=\"ds-field-label\"><label for=\"ds-title\">Title</label><span>15 karakter</span></div><input id=\"ds-title\" type=\"text\" value=\"Tropical forest\" autocomplete=\"off\"/></div>",
      "css": ".ds-field{font-family:system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;width:300px;max-width:100%;color:var(--text,#2f3f54)}.ds-field-label{display:flex;align-items:center;gap:5px;margin-bottom:8px}.ds-field-label label{font-size:12px;font-weight:650}.ds-field-label span{margin-left:auto;font-size:10px;color:var(--muted,#506379);font-variant-numeric:tabular-nums}.ds-field input{box-sizing:border-box;font-family:system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;width:100%;padding:10px 11px;border:1px solid var(--border,#a7bacb);border-radius:1px;background:#fff;color:var(--text,#2f3f54);font-size:13px;caret-color:var(--purple,#7b68a4)}.ds-field input::placeholder{color:#65768a;opacity:1}.ds-field input:focus-visible{outline:2px solid var(--purple,#7b68a4);outline-offset:2px}.ds-field input:disabled{background:#f5f8fa;opacity:1;color:var(--muted,#506379)}"
    },
    {
      "name": "Asset navigation row",
      "kind": "nav",
      "refersTo": "asset-row-active",
      "description": "Independent batch checkbox, active asset fill, and written draft/save state.",
      "html": "<nav class=\"ds-assets\" aria-label=\"Daftar aset\"><div class=\"ds-asset-row ds-active\"><input type=\"checkbox\" checked aria-label=\"Pilih tropical-forest.jpg\"/><button type=\"button\" class=\"ds-asset-item\" aria-pressed=\"true\"><strong>tropical-forest.jpg</strong><span>JPG · 4.2 MB</span><small class=\"ds-modified\">Belum disimpan</small></button></div><div class=\"ds-asset-row\"><input type=\"checkbox\" aria-label=\"Pilih leaves.png\"/><button type=\"button\" class=\"ds-asset-item\" aria-pressed=\"false\"><strong>leaves.png</strong><span>PNG · 2.1 MB</span><small class=\"ds-ready\">Siap disunting</small></button></div></nav>",
      "css": ".ds-assets{font-family:system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;width:226px;background:#edf3f5;color:var(--text,#2f3f54)}.ds-asset-row{display:flex;gap:9px;align-items:flex-start;padding:9px 8px;border:1px solid transparent;margin-bottom:3px}.ds-asset-row.ds-active{background:#e2dced;border-color:#b0a2ca}.ds-asset-row>input{width:13px;height:13px;margin:4px 0 0;flex-shrink:0;accent-color:var(--purple,#7b68a4);cursor:pointer}.ds-asset-row>input:focus-visible,.ds-asset-item:focus-visible{outline:2px solid var(--purple,#7b68a4);outline-offset:2px}.ds-asset-item{font-family:system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:flex;flex:1;flex-direction:column;align-items:flex-start;justify-content:flex-start;min-width:0;min-height:0;padding:0;gap:4px;background:none;border:0;border-radius:1px;text-align:left;color:var(--text,#2f3f54);cursor:pointer}.ds-asset-item strong{max-width:100%;font-size:12px;white-space:nowrap;text-overflow:ellipsis;overflow:hidden;font-weight:650}.ds-asset-item>span{font-size:10px;color:var(--muted,#506379)}.ds-asset-item small{font-size:10px;margin-top:2px}.ds-modified{color:#6f528e}.ds-ready{color:#415d5c}.ds-asset-item:disabled{opacity:.5;cursor:default}"
    },
    {
      "name": "Ordered keyword row",
      "kind": "custom",
      "refersTo": "keyword-row",
      "description": "A readable ordinal and phrase with compact SVG reorder controls.",
      "html": "<div class=\"ds-keyword-row\"><span class=\"ds-keyword-number\">2</span><span class=\"ds-keyword-text\">tropical forest</span><button type=\"button\" class=\"ds-keyword-move\" aria-label=\"Naikkan tropical forest\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m6 15 6-6 6 6\"/></svg></button><button type=\"button\" class=\"ds-keyword-move\" aria-label=\"Turunkan tropical forest\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></button></div>",
